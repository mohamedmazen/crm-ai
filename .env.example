APP_NAME="AYDRA"

# Brand name and tagline for the Arabic interface. Resolved per request locale
# by App\Support\Brand; falls back to APP_NAME / SAAS_TAGLINE when unset.
SAAS_APP_NAME_AR="أيدرا"
SAAS_TAGLINE="Your Business. Smarter."
SAAS_TAGLINE_AR="أعمالك، بذكاء أكبر."

APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Demo mode: run the app as a public, read-only showcase.
# When true, all create/update/delete operations (web + admin + /api/v1) are
# blocked and every contact's PII (name, phone, email, address) is masked
# before it reaches the browser.
APP_DEMO_MODE=false

# App version — the License Manager and auto-updater compare this against the
# latest published release to decide whether an update is available.
APP_VERSION=1.9.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Optional: path to a CA bundle for outbound HTTPS (Meta API / Guzzle).
# Leave blank to use the system/PHP default CA store. Set only if your host
# needs an explicit bundle, e.g. /etc/ssl/certs/cacert.pem
HTTP_CLIENT_CA_PATH=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database: use mysql for production; sqlite for local when preferred
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads at rest and only send the cookie over HTTPS.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# Realtime broadcasting. Set to "reverb" (self-hosted, see Reverb block below)
# or "pusher" to enable live updates; "log" keeps realtime off.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue: use "redis" when Redis is available; "database" otherwise
QUEUE_CONNECTION=database

# Must stay above the largest job $timeout (currently 300s) so a slow job is
# never released back onto the queue and executed twice.
DB_QUEUE_RETRY_AFTER=1200
REDIS_QUEUE_RETRY_AFTER=1200

# Per-tenant queue limits (see config/queue.php). Bulk work is throttled per
# workspace so one tenant cannot monopolise the shared workers.
QUEUE_TENANT_MESSAGES_PER_MINUTE=120
QUEUE_TENANT_SOCIAL_POSTS_PER_MINUTE=30
QUEUE_TENANT_CONCURRENT_BROADCAST_JOBS=2
QUEUE_TENANT_CONCURRENT_SOCIAL_JOBS=1
QUEUE_TENANT_CONCURRENT_AI_JOBS=1
QUEUE_TENANT_CONCURRENT_ECOMMERCE_JOBS=1
QUEUE_TENANT_MAX_ACTIVE_CAMPAIGNS=2
QUEUE_TENANT_CAMPAIGN_FINALIZE_MAX_ATTEMPTS=10080

# Cache: use "redis" when Redis is available; "database" otherwise
CACHE_STORE=database
# CACHE_PREFIX=

# Inertia: set to true when using SSR server
INERTIA_SSR_ENABLED=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Use a real SMTP provider in production (host/username/password from
# your provider's dashboard). "log" writes mail to the log instead of sending.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3-compatible storage (leave blank to use local disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Security / reverse proxy
# ---------------------------------------------------------------------------
# Comma-separated IPs or CIDR ranges of the proxy/load-balancer in front of the
# app (e.g. "127.0.0.1" when nginx runs on the same host). Leave empty to trust
# no proxy. NEVER set "*": it lets any client spoof X-Forwarded-For and bypass
# rate limiting and the admin IP allowlist.
TRUSTED_PROXIES=

# Bearer token required by /healthz/*. Generated with:
#   php -r "echo bin2hex(random_bytes(32));"
# When empty, /healthz/* is only reachable outside production.
HEALTHZ_TOKEN=

# Sanctum API token lifetime in minutes (default: 60 days).
SANCTUM_EXPIRATION=86400

# ---------------------------------------------------------------------------
# Initial seed accounts
# ---------------------------------------------------------------------------
# Super admin created the first time you seed the database. Leave the password
# empty to have a strong random one generated and printed once by the seeder.
# NEVER reuse these values on a production server.
ADMIN_SEED_NAME="Super Admin"
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# One-click client sign-in card, only shown when APP_DEMO_MODE=true. It mirrors
# the Starter demo tenant seeded by DemoStarterSeeder.
DEMO_CLIENT_EMAIL=starter@aydra.demo
DEMO_CLIENT_PASSWORD=starter@aydra.demo

# ---------------------------------------------------------------------------
# BYOK-only mode (bring your own keys for every tenant service)
# ---------------------------------------------------------------------------
# When true, a workspace must supply its own AI, SMS, WhatsApp and SMTP
# credentials. The platform never silently falls back to system-owned keys for
# tenant traffic, so an unconfigured workspace fails with a clear error instead
# of spending your money. Platform-owned services are unaffected: storage, the
# Meta App identity (webhook verification / Embedded Signup) and payment
# gateways.
BYOK_ONLY=false

# ---------------------------------------------------------------------------
# AI (bring your own provider key)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
AI_CREDITS_PER_GENERATION=10

# Optional: Qdrant vector store for AI knowledge base / RAG
QDRANT_URL=
QDRANT_API_KEY=

# Minimum cosine similarity (0-1) a knowledge-base chunk must reach to be used
# as chatbot context. Raise it if the bot answers unrelated questions; set 0 to
# restore "always return top-k". The useful range differs per embedding model.
AI_RETRIEVAL_MIN_SCORE=0.25

# Seconds a query embedding is cached per workspace + model (0 disables it).
AI_EMBEDDING_CACHE_TTL=3600

# Hybrid search: extra weight (0..1) an exact keyword match adds on top of the
# cosine score. Helps product codes and rare terms; 0 = semantic only.
AI_RETRIEVAL_KEYWORD_BOOST=0.3

# Stream chatbot playground replies over server-sent events (true/false).
AI_STREAMING_ENABLED=true

# Maximum tokens of knowledge-base context injected into one chatbot prompt
# (roughly chars/4). Retrieved chunks are added in rank order until it is spent.
AI_MAX_CONTEXT_TOKENS=2000

# ---------------------------------------------------------------------------
# Billing gateways (set BILLING_*_ENABLED=true and credentials to enable).
# Publishable/secret keys for Stripe etc. are configured in the admin panel
# under Payment Gateways; the values below are server-side secrets only.
# ---------------------------------------------------------------------------
BILLING_STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL="${APP_URL}/app/pricing?checkout=success"
STRIPE_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"

BILLING_PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=
PAYPAL_SUCCESS_URL="${APP_URL}/app/pricing?checkout=success"
PAYPAL_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"

# Paymob (Egypt / GCC / Pakistan) — hosted first charge + MIT saved-card renewals.
# Renewals run via the billing:charge-recurring-paymob scheduler. Webhook: ${APP_URL}/webhooks/paymob
BILLING_PAYMOB_ENABLED=false
PAYMOB_API_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_SUCCESS_URL="${APP_URL}/app/billing?checkout=success"
PAYMOB_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"

# MyFatoorah (Kuwait / GCC) — hosted first charge + MIT saved-token renewals.
# Renewals run via the billing:charge-recurring-myfatoorah scheduler. Webhook: ${APP_URL}/webhooks/myfatoorah
BILLING_MYFATOORAH_ENABLED=false
MYFATOORAH_API_KEY=
MYFATOORAH_SANDBOX=true
MYFATOORAH_SUCCESS_URL="${APP_URL}/app/billing?checkout=success"
MYFATOORAH_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"

# Fawry (Egypt) — one-time checkout: card, mobile wallet or cash at a Fawry outlet.
# No saved-card recurring; renewal is a fresh checkout. Webhook: ${APP_URL}/webhooks/fawry
BILLING_FAWRY_ENABLED=false
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=
FAWRY_SANDBOX=true
FAWRY_SUCCESS_URL="${APP_URL}/app/billing?checkout=success"
FAWRY_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"

# Tap Payments (Kuwait / GCC / Egypt) — hosted first charge + MIT saved-card renewals.
# Renewals run via the billing:charge-recurring-tap scheduler. Webhook: ${APP_URL}/webhooks/tap
BILLING_TAP_ENABLED=false
TAP_API_KEY=
TAP_SUCCESS_URL="${APP_URL}/app/billing?checkout=success"
TAP_CANCEL_URL="${APP_URL}/app/pricing?checkout=canceled"
TAP_WEBHOOK_URL="${APP_URL}/webhooks/tap"

# ---------------------------------------------------------------------------
# Realtime — Option A: Pusher (hosted). Set BROADCAST_CONNECTION=pusher above.
# ---------------------------------------------------------------------------
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------------------
# Realtime — Option B: Laravel Reverb (self-hosted WebSocket server, bundled).
# Set BROADCAST_CONNECTION=reverb above and run `php artisan reverb:start`.
# The frontend connects via the Pusher protocol, so point VITE_PUSHER_APP_KEY
# at REVERB_APP_KEY when using Reverb.
# ---------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ---------------------------------------------------------------------------
# Web push notifications (VAPID). Generate with: php artisan webpush:vapid
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY="${VAPID_PUBLIC_KEY}"

# Optional: OneSignal push notifications
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ---------------------------------------------------------------------------
# Social login (optional — Laravel Socialite). Configure the providers you use.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# ---------------------------------------------------------------------------
# SMS gateways — optional webhook secrets for DLR delivery status callbacks.
# Credentials are stored per-workspace in the database (Settings → SMS Gateways).
# Supported providers: Twilio, Vonage/Nexmo, Telnyx, ClickSend, Amazon SNS,
# SMS Misr, CEQUENS, Unifonic, Taqnyat, Msegat and Infobip.
# ---------------------------------------------------------------------------
# Telnyx — set this if you configure a DLR callback URL in the Telnyx portal.
# DLR URL: ${APP_URL}/webhooks/sms/telnyx
TELNYX_WEBHOOK_SECRET=

# ClickSend — set this if you configure a DLR callback URL in the ClickSend dashboard.
# DLR URL: ${APP_URL}/webhooks/sms/clicksend
CLICKSEND_WEBHOOK_SECRET=

# SMS Misr — secret echoed back on the DLR callback (optional).
# DLR URL: ${APP_URL}/webhooks/sms/sms_misr
SMS_MISR_WEBHOOK_SECRET=

# CEQUENS — secret echoed back on the DLR callback (optional).
# DLR URL: ${APP_URL}/webhooks/sms/cequens
CEQUENS_WEBHOOK_SECRET=

# Unifonic — secret echoed back on the DLR callback (optional).
# DLR URL: ${APP_URL}/webhooks/sms/unifonic
UNIFONIC_WEBHOOK_SECRET=

# Taqnyat — set this if you configure the SMS Webhook in the Taqnyat portal.
# DLR URL: ${APP_URL}/webhooks/sms/taqnyat
TAQNYAT_WEBHOOK_SECRET=

# Msegat — secret echoed back on the DLR callback (optional).
# DLR URL: ${APP_URL}/webhooks/sms/msegat
MSEGAT_WEBHOOK_SECRET=

# Infobip — secret echoed back on the DLR callback (optional).
# DLR URL: ${APP_URL}/webhooks/sms/infobip
INFOBIP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Form spam protection (optional). Forms opt in per form; a form that asks for
# a CAPTCHA refuses submissions until its secret is configured.
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# Error monitoring (optional — Sentry). Leave blank to disable.
# ---------------------------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
